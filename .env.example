# ─────────────────────────────────────────────────────────────
# Oppskriftsboken – miljøvariabler
#
# Kopier denne filen til ".env.local" og fyll inn dine egne verdier.
# ".env.local" skal ALDRI committes til git (den ligger allerede i .gitignore).
#
# Uten disse variablene kjører nettsiden i "demo-modus": den viser
# eksempeloppskriftene fra lib/demo-data i stedet for å lese fra Supabase,
# og admin-innlogging er skrudd av. Det gjør at du kan se og teste designet
# før du har satt opp Supabase.
# ─────────────────────────────────────────────────────────────

# Finnes under Project Settings → API i Supabase-prosjektet ditt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kun for server-side bruk (seeding-scriptet og evt. fremtidige admin-only
# operasjoner). Dette er den hemmelige "service_role"-nøkkelen.
# ALDRI eksponer denne i klientkode eller prefiks den med NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Navnet på Supabase Storage-bucketen der oppskriftsbilder lagres.
# Opprettes automatisk av migrasjonen i supabase/migrations, men må hete
# det samme her.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=recipe-images

# Brukes til absolutte URL-er i SEO-metadata (Open Graph, canonical, JSON-LD).
# Sett til f.eks. https://oppskriftsboken.no i produksjon.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kreves for AI-funksjonene: vinanbefaling, vin-match (tekst og bilde),
# vegetarvariant og engelsk oversettelse (lib/actions/ai.ts). Hentes fra
# console.anthropic.com. Uten denne feiler kun disse funksjonene – resten
# av siden fungerer som normalt.
ANTHROPIC_API_KEY=

# Kreves KUN for "Generer AI-bilde" i admin (bildegenerering av retten,
# frem til et ekte foto legges inn). Egen, separat tjeneste/nøkkel fra
# Anthropic – hentes fra platform.openai.com. Uten denne feiler kun denne
# ene knappen.
OPENAI_API_KEY=

# Kreves KUN for det konkrete Vinmonopolet-forslaget ("Vil du ha et konkret
# forslag fra Vinmonopolet?" under vinanbefalingen). Egen, separat nøkkel –
# hentes fra api.vinmonopolet.no/profile (Primary key, etter du har
# abonnert på "Open"-produktet). Uten denne feiler kun dette ene forslaget.
VINMONOPOLET_API_KEY=
